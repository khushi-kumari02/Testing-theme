{{ 'section-custom-collection-banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding custom-collection-banner-wrapper">
    {% if section.settings.collection-desktop-banner != blank %}
      {% render 'responsive-picture',
        desktopImage: section.settings.collection-desktop-banner,
        mobileImage: section.settings.collection-mobile-banner,
        img-class: 'w-full'
      %}
    {% endif %}
  </div>
 {% schema %}
{
  "name": "Custom collection banner",
  "tag": "section",
  "class": "section custom-collection-banner",
  "settings": [
    {
        "type": "image_picker",
        "id": "collection-desktop-banner",
        "label": "Desktop banner",
        "info": "recommended image-size 1400px * 700px"
    },
    {
        "type": "image_picker",
        "id": "collection-mobile-banner",
        "label": "Mobile banner",
        "info": "recommended image-size 400px * 300px"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  
  "presets": [
    {
      "name": "Custom collection banner",
      "category": "Collection",
    },
  ]
}
{% endschema %}

{{ 'image-gallery.css' | asset_url | stylesheet_tag }}

<div class="image-gallery-container-wrapper page-width">
  <h2>{{ block.settings.gallery_heading }} Interactive Image Gallery</h2>

  <!-- Input for Adding Images -->
  <input type="text" id="image-url" placeholder="Enter Image URL">
  <input type="text" id="image-name" placeholder="Enter Image Name">
  <button id="add-image-btn">Add Image</button>

  <p id="status-message" class="status-message"></p>

  <!-- Search Input -->
  <input type="text" id="search-input" placeholder="Search by Image Name">

  <!-- Image Gallery Section -->
  <div id="image-gallery" class="image-gallery"></div>
  
</div>

<!-- Here is JS Code -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const imageUrlInput = document.getElementById("image-url");
    const imageNameInput = document.getElementById("image-name");
    const addImageBtn = document.getElementById("add-image-btn");
    const searchInput = document.getElementById("search-input");
    const imageGallery = document.getElementById("image-gallery");
    const statusMessage = document.getElementById("status-message");

    function showMessage(message, type = "success") {
      statusMessage.textContent = message;
      statusMessage.className = `status-message ${type}`;
      setTimeout(() => {
        statusMessage.textContent = "";
        statusMessage.classList.remove(type);
      }, 3000);
    }

    function loadImages() {
      imageGallery.innerHTML = "";
      const savedImages = JSON.parse(localStorage.getItem("imageGallery")) || [];
      savedImages.forEach(({ name, url }) => createImageElement(name, url));
    }

    function createImageElement(name, url) {
      const imgWrapper = document.createElement("div");
      imgWrapper.classList.add("gallery-item-wrapper");

      const imgElement = document.createElement("img");
      imgElement.src = url;
      imgElement.alt = name;
      imgElement.classList.add("gallery-item");

      const caption = document.createElement("p");
      caption.textContent = name;
      caption.classList.add("image-caption");

      imgWrapper.appendChild(imgElement);
      imgWrapper.appendChild(caption);
      imageGallery.appendChild(imgWrapper);
    }

    addImageBtn.addEventListener("click", function () {
      const imageUrl = imageUrlInput.value.trim();
      const imageName = imageNameInput.value.trim();

      if (!imageUrl || !imageName) {
        showMessage("Please enter both an image URL and a name.", "error");
        return;
      }

      if (isValidUrl(imageUrl)) {
        const savedImages = JSON.parse(localStorage.getItem("imageGallery")) || [];
        savedImages.push({ name: imageName, url: imageUrl });
        localStorage.setItem("imageGallery", JSON.stringify(savedImages));

        createImageElement(imageName, imageUrl);
        imageUrlInput.value = "";
        imageNameInput.value = "";
        showMessage("Image added successfully!", "success");
      } else {
        showMessage("Please enter a valid image URL.", "error");
      }
    });

    function isValidUrl(string) {
      try {
        new URL(string);
        return true;
      } catch (_) {
        return false;
      }
    }

    searchInput.addEventListener("input", function () {
      const searchTerm = searchInput.value.toLowerCase();
      document.querySelectorAll(".gallery-item-wrapper").forEach((imgWrapper) => {
        const imageName = imgWrapper.querySelector(".image-caption").textContent.toLowerCase();
        imgWrapper.style.display = imageName.includes(searchTerm) ? "block" : "none";
      });
    });

    loadImages();
  });
</script>

{% schema %}
{
  "name": "Image gallery",
  "settings": [],
  "blocks": [
    {
    "type": "Gallery",
    "name":"Gallery",
    "settings": [
          {
    "type": "text",
    "id": "gallery_heading",
    "label": "Gallery Heading",
    "default": "Gallery heading"
  },
  {
    "type": "range",
    "id": "gallery_columns",
    "label": "Number of Columns",
    "min": 2,
    "max": 6,
    "default": 4
  },
      {
    "type": "textarea",
    "id": "gallery_image_urls",
    "label": "Image URLs",
    "info": "Enter multiple image URLs separated by commas.",

  }

  ]
}
  ],
  "presets": [
    {
      "name": "Image gallery"
    }
  ]
}
{% endschema %}

{{ 'custion-slider.css' | asset_url | stylesheet_tag }}

<div class="custom-slider-wrapper page-width">
  <custom-slider>
    <section class="splide" aria-label="Splide Basic HTML Example">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide">
              <div class="custom-slider__slide-container isolate">
                <div class="custom-slider__slide-image-container"></div>

                <div class="custom-slider__slide-text-content-wrapper absolute ">
                  <div class="custom-slider__slide-text-content-inner-wrapper">
                    <div class="custom-slider__slide-text-content-heading heading">
                      {{ block.settings.slider_heading }}
                    </div>
                    <div class="custom-slider__slide-text-content-description description">
                      {{ block.settings.slider_description }}
                    </div>
                    <div class="custom-slider__slide-text-content-button button">
                      <a href="{{ block.settings.slider_button_link }}">
                        {{ block.settings.slider_button_label }}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </section>
  </custom-slider>
</div>

{% schema %}
{
  "name": "Custom slider",
  "settings": [],
  "blocks": [
    {
      "type": "Slider",
      "name":"Slider",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image_desktop",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "banner_image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "slider_heading",
          "label": "Heading",
          "default": "Heading"

        },
        {
          "type": "text",
          "id": "slider_description",
          "label": "Description",
          "default": "Description"

        },
        {
          "type": "text",
          "id": "slider_button_label",
          "label": "Button label",
          "default": "Explore More"

        },
        {
          "type": "url",
          "id": "slider_button_link",
          "label": "Button link"
          },

      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider",
      "blocks": [
        {
          "type": "Slider"
        },
        {
          "type": "Slider"
        },
        {
          "type": "Slider"
        }
      ]
    }
  ]
}
{% endschema %}

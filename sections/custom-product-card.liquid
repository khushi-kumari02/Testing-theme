{{ 'custom-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-product-card.js' | asset_url }}" defer></script>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% liquid
  assign blocks = section.blocks
%}
{% comment %} assign products_to_show = 3 {% endcomment %}


<div class="custom-product-card__wrapper page-width section-{{ section.id }}-padding">
  <div class="custom-product-card__header">
      {%- if section.settings.section_heading != blank -%}
        <h2 class="custom-product-card__heading section-heading">
          {{ section.settings.section_heading }}
        </h2>
      {%- endif -%}
    
    <div class="custom-product-card__header-tab-wrapper">
      {%- for block in blocks -%}
        {%- if block.settings.tab_title != blank -%}
          <span
            data-tab-opener="{{ block.settings.tab_title | handle }}"
            class="tab-button {% if forloop.first %} active {% endif %}"
          >
            {{ block.settings.tab_title }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="custom-product-card__main-content">
    {%- for block in blocks -%}
      {%- if block.settings.tab_title != blank -%}
        <div
          data-content-matcher="{{ block.settings.tab_title | handle }}"
          class="tab-content {% unless forloop.first %} custom-hidden {% endunless %} grid grid--4-col-desktop grid--2-col-mobile"
        >
          {% assign collection = block.settings.collection %}

          {%- if block.settings.collection_image != blank -%}
            <div class="custom-product-card__editorial-image grid__item isolate">
              {% render 'responsive-picture', desktopImage: block.settings.collection_image %}
              <div class="custom-overlay absolute">
                <span> {{ collection.title }}</span>
              </div>
            </div>
          {%- endif -%}
          {%- for product in collection.products -%}
            <div class="grid__item">
              {% render 'custom-product-card',
                product: product,
                show_badge_on_sale: section.settings.show_badge_on_sale
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<button data-section="{{ section.id }}">
  Click me to duplicate the section
</button>
<div id="incoming-html"></div>


{% schema %}
{
  "name": "Custom product card",
  "class": "custom-product-card",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Exceptional Pieces"
    },
    {
      "type": "header",
      "content": "Custom product card customization"
    },
    {
      "type": "checkbox",
      "id": "show_badge_on_sale",
      "label": "Show on sale badge",
      "default": true,
      "info": "Show 'On Sale' badge when the compare-at price is higher than the selling price"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "Tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom product card"
    }
  ]
}
{% endschema %}
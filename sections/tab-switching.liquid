<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js" defer></script>
<link href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" rel="stylesheet">

{{ 'tab-switching.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tab-switching.js' | asset_url }}" defer></script>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% liquid
    assign blocks = section.blocks
  %}
  
  <div class="fresh-tabs-wrapper page-width section-{{ section.id }}-padding">
    <div class="fresh-tabs-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="fresh-tabs-heading section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
  
      <div class="fresh-tabs-nav">
        {%- for block in blocks -%}
          {%- if block.settings.tab_title != blank -%}
            <button
              class="tab-button{% if forloop.first %} active{% endif %}"
              data-tab-opener="{{ block.settings.tab_title | handle }}"
            >
              {{ block.settings.tab_title }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  
    <div class="fresh-tabs-content">
      {%- for block in blocks -%}
        {%- assign collection = block.settings.collection -%}
        <div
          class="tab-panel{% unless forloop.first %} custom-hidden{% endunless %}"
          data-content-matcher="{{ block.settings.tab_title | handle }}"
        >
          {%- if block.settings.collection_image != blank -%}
            <div class="collection-image grid__item isolate">
              {% render 'responsive-picture', desktopImage: block.settings.collection_image %}
              <div class="collection-overlay absolute">
                <span>{{ collection.title }}</span>
              </div>
            </div>
          {%- endif -%}
  
          {%- if collection.products.size > 0 -%}
            <div class="splide" id="splide-{{ forloop.index }}">
              <div class="splide__track">
                <ul class="splide__list">
                  {%- for product in collection.products -%}
                    <li class="splide__slide">
                      {% render 'custom-card-product', product: product %}
                    </li>
                  {%- endfor -%}

                  <!-- View All Slide -->
                  <li class="splide__slide view-all">
                  <a href="{{ collections[block.settings.collection].url }}">View All →</a>
                  </li>
                </ul>
              </div>
            </div>
          {%- else -%}
            <p class="no-products">No products found in this collection.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
    

{% schema %}
{
  "name": "Fresh product tabs",
  "tag": "section",
  "class": "section-fresh-tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Fresh From The Source"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab title",
          "default": "Syrups"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Fresh product tabs",
      "category": "Collection",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_title": "SYRUPS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "Jams & Spreads"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "Fruit Chews"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "SNACKS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "CHOCOLATES"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="blog-sidebar-section">
    <h3 class="blog-sidebar-heading">Recent Posts</h3>
  
    {% assign recent_posts = blog.articles | sort: 'published_at' | reverse %}
    {% for article in recent_posts limit: 3 %}
      <div class="recent-post">
        <a href="{{ article.url }}" class="recent-post-link">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 80 }}" alt="{{ article.title }}">
          {% else %}
            <img src="https://via.placeholder.com/80x80" alt="Placeholder">
          {% endif %}
          <div class="recent-post-content">
            <h4>{{ article.title }}</h4>
            <p class="recent-post-date">{{ article.published_at | date: '%B %d, %Y' }}</p>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  
  
  <style>
    .blog-sidebar-section {
        background-color: #fff;
        padding: 20px 20px 16px;
        margin-bottom: 25px;
        border-radius: 12px;
        overflow: hidden;
      }
      
      .blog-sidebar-heading {
        background-color: #f4f4f4;
        padding: 12px 16px;
        margin: -20px -20px 16px;
        font-size: 16px;
        font-weight: 700;
        color: #000;
        border-radius: 12px;
        letter-spacing: 0.5px;
      }
            
      .recent-post {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
      }
      
      .recent-post-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: #333;
      }
      
      .recent-post img {
        width: 80px;
        height: 50px;
        object-fit: cover;
        border-radius: 12px;
        margin-right: 12px;
        flex-shrink: 0;
      }
      
      .recent-post-content {
        flex: 1;
      }
      
      .recent-post h4 {
        font-size: 15px;
        margin: 0 0 4px;
        font-weight: 500;
        color: #000;
        text-transform: capitalize;
        line-height: 1.3;
      }
      
      .recent-post-date {
        font-size: 13px;
        color: #888;
        margin: 0;
      }
      
      .recent-post-link:hover h4 {
        color: #e91e63;
      }
      
  </style>
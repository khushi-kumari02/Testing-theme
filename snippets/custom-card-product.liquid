<div class="custom-product-card-wrapper product-card">
  <a href="{{ product.url }}" class="custom-product-card__image">
    {% render 'responsive-picture', desktopImage: product.featured_image, class: "image-fit" %}

    <!-- Add to Bag Button (shows on hover) -->
    <div class="hover-add-to-cart-form">
      <button
        type="button"
        class="hover-add-to-cart-btn"
        onclick="addToCart('{{ product.variants.first.id }}')"
      >
        ADD TO BAG
      </button>
    </div>
  </a>

  <div class="custom-product-card__info">
    <!-- Product Title -->
    <a href="{{ product.url }}">
      <h4 class="custom-product-card__title">
        {{ product.title }}
      </h4>
    </a>

    <!-- Product Rating (if available) -->
      <div class="custom-product-card__rating">
        {% comment %} {{ product.metafields.my_store.product_rating  }}
        {% assign rating = product.metafields.my_store.product_rating.value | plus:0 | round %} {% endcomment %}
        {% assign raw_rating = product.metafields.my_store.product_rating | append:'' %}
        {{raw_rating }}
        {% comment %} {%assign rating = raw_rating | times: 1.0 %} {% endcomment %}
        {% comment %} {{"4.8" | times:1.0 | round }} {% endcomment %}
        {% comment %} {% assign rating_rounded = rating_float | round %} {% endcomment %}
        <p>rating:{{rating }}</p>
        {% comment %} <p>Raw: {{ raw_rating }}</p> {% endcomment %}
        {% comment %} <p>As float: {{ rating_float }}</p> {% endcomment %}
        {% comment %} <p>Rounded: {{ rating_rounded }}</p> {% endcomment %}
        
        {% comment %} {% for i in (1..rating) %}
            <span class="star filled">a</span>
        {% endfor %} {% endcomment %}
      </div>
    <!-- Pricing -->
    <div class="custom-product-card__pricing">
      <span class="custom-product-card__price">
        {{ product.price | money_with_currency }}
      </span>

      {% if product.compare_at_price > product.price %}
        <br>
        <strike class="custom-product-card__compare-price">
          {{ product.compare_at_price | money_with_currency }}
        </strike>
      {% endif %}
    </div>

    <!-- Variant Dropdown -->
    <div class="custom-product-card__variants">
      <label for="product-variant-{{ product.id }}"></label>
      <select class="product-variant" id="product-variant-{{ product.id }}">
        <option value="750ml">750ml</option>
        <option value="1000ml">1000ml</option>
      </select>
    </div>
  </div>
</div>
